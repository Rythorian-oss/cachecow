{
  "UpdateSettings": {
    "EnableAutoUpdate": true,
    "ReleaseChannel": "https://api.github.com/repos/Rythorian-oss/cachecow/releases"
  },
  "Optimization": {
    "FlushDnsCache": true
  },
  "DuplicateScanner": {
    "Enabled": true,
    "TargetDirectories": [
      "%USERPROFILE%/Downloads",
      "%USERPROFILE%/Documents"
    ],
    "TargetExtensions": [".zip", ".pdf", ".mp4", ".jpg", ".png", ".exe", ".docx"]
  },
  "Targets": [
    { "Name": "Windows Temp", "WindowsPath": "%WINDIR%/Temp", "MacPath": "", "LinuxPath": "", "Type": "Directory", "IsProtected": false },
    { "Name": "User Temp", "WindowsPath": "%TEMP%", "MacPath": "$TMPDIR", "LinuxPath": "/tmp", "Type": "Directory", "IsProtected": false },
    { "Name": "Windows Update Cache", "WindowsPath": "%WINDIR%/SoftwareDistribution/Download", "MacPath": "", "LinuxPath": "", "Type": "Directory", "IsProtected": false },
    { "Name": "Windows Prefetch", "WindowsPath": "%WINDIR%/Prefetch", "MacPath": "", "LinuxPath": "", "Type": "Directory", "IsProtected": false },
    { "Name": "DirectX Shader Cache", "WindowsPath": "%LOCALAPPDATA%/D3DSCache", "MacPath": "", "LinuxPath": "", "Type": "Directory", "IsProtected": false },
    { "Name": "Mac User Caches", "WindowsPath": "", "MacPath": "~/Library/Caches", "LinuxPath": "", "Type": "Directory", "IsProtected": false },
    { "Name": "Linux User Caches", "WindowsPath": "", "MacPath": "", "LinuxPath": "~/.cache", "Type": "Directory", "IsProtected": false },
    { "Name": "System Trash", "WindowsPath": "RecycleBin", "MacPath": "~/.Trash", "LinuxPath": "~/.local/share/Trash", "Type": "SystemObject", "IsProtected": false },
    { "Name": "Edge Profiles", "WindowsPath": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "MacPath": "~/Library/Application Support/Microsoft Edge", "LinuxPath": "~/.config/microsoft-edge", "Type": "Directory", "IsProtected": true }
  ]
}
