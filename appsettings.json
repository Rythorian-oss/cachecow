{
  "UpdateSettings": {
    "EnableAutoUpdate": true,
    "ReleaseChannel": "https://api.github.com/repos/Rythorian-oss/cachecow/releases"
  },
  "SystemRestorePoint": {
    "Enabled": true,
    "Description": "Cache Cow - Pre-Cleanup Safety Protocol (Windows Only)"
  },
  "Targets": [
    {
      "Name": "User Temp Folder",
      "WindowsPath": "%TEMP%",
      "MacPath": "$TMPDIR",
      "LinuxPath": "/tmp",
      "Type": "Directory",
      "IsProtected": false
    },
    {
      "Name": "Visual Studio Website Cache",
      "WindowsPath": "%LOCALAPPDATA%/Microsoft/WebsiteCache",
      "MacPath": "~/Library/Caches/Microsoft/WebsiteCache",
      "LinuxPath": "~/.cache/Microsoft/WebsiteCache",
      "Type": "Directory",
      "IsProtected": false
    },
    {
      "Name": "Recycle Bin / Trash",
      "WindowsPath": "RecycleBin",
      "MacPath": "~/.Trash",
      "LinuxPath": "~/.local/share/Trash",
      "Type": "SystemObject",
      "IsProtected": false
    },
    {
      "Name": "Edge User Data",
      "WindowsPath": "%LOCALAPPDATA%/Microsoft/Edge/User Data",
      "MacPath": "~/Library/Application Support/Microsoft Edge",
      "LinuxPath": "~/.config/microsoft-edge",
      "Type": "Directory",
      "IsProtected": true
    }
  ]
}